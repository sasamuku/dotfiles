# This is intended as GLOBAL ~/.gitignore, not just this dotfiles repo. (But.. it's both.)
# See .gitconfig: excludesFile = ~/.gitignore

# Secrets and sensitive files
.zsh_secrets
.zshrc.secrets
.gitconfig.local
.env
.env.local

# Operating System
.DS_Store

# Environment Management
.envrc

# Editors and IDEs
.vscode/
.cursor/
.zed/

# Language Specific
## Ruby
*.gem
.pryrc

## Python
__pycache__/
*.pyc

# Development Tools
## Worktrunk (repository-local configuration)
/.config/wt.toml

# Legacy local data
.serena/

# AI Tools
## Claude
.claude/settings.local.json

## Playwright MCP
.playwright-mcp/

## sasamuku スキルの自律ランの記録
.sasamuku/

# Scratch Directory
scratch/
scratch

# Project Specific
*.code-workspace

**/.claude/settings.local.json

# Claude Code がクラウドから同期するスキルのキャッシュ
.claude/skills/synced/
.agents/skills/synced/

# スキルの退避データ
.claude/skills/.trash/

# cmux の codex ラッパーが ~ をリテラル展開して作るディレクトリ
/~/

# yomiyasu の検査記録
.yomiyasu/
